{
	"name": "@schubergphilis/sbp-flow-graph",
	"private": false,
	"version": "0.0.79",
	"license": "MIT",
	"description": "Flow diagrams based on Force directed bubbles for ReactJS projects.",
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		"types": "./dist/index.d.ts",
		"import": "./dist/esm/index.mjs.js",
		"require": "./dist/cjs/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"lint:fix": "eslint --fix 'src/**/*.{js,jsx,ts,tsx,json}'",
		"format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
		"preview": "vite preview",
		"clean": "rimraf dist",
		"build": "pnpm clean && rollup -c",
		"release": "standard-version"
	},
	"peerDependencies": {
		"react": "^19.2.5",
		"react-dom": "^19.2.5"
	},
	"dependencies": {
		"@schubergphilis/sbp-frontend-style": "^1.13.1-0",
		"lodash.debounce": "^4.0.8",
		"styled-components": "^6.4.1"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.5",
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^10.0.1",
		"@open-wc/building-rollup": "^3.0.2",
		"@reduxjs/toolkit": "^2.11.2",
		"@rollup/plugin-alias": "^6.0.0",
		"@rollup/plugin-commonjs": "^29.0.2",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-sucrase": "^5.1.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@rollup/plugin-terser": "^1.0.0",
		"@types/lodash.debounce": "^4.0.9",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/styled-components": "^5.1.36",
		"@typescript-eslint/eslint-plugin": "^8.59.0",
		"@typescript-eslint/parser": "^8.59.0",
		"@vitejs/plugin-react-swc": "^4.3.0",
		"eslint": "10.2.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.5.0",
		"prettier": "^3.8.3",
		"prettier-plugin-organize-imports": "^4.3.0",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"react-redux": "^9.2.0",
		"rimraf": "^6.1.3",
		"rollup": "^4.60.2",
		"rollup-plugin-delete": "^3.0.2",
		"rollup-plugin-dts": "^6.4.1",
		"rollup-plugin-peer-deps-external": "^2.2.4",
		"rollup-plugin-tsconfig-paths": "^1.5.2",
		"rollup-plugin-typescript": "^1.0.1",
		"standard-version": "^9.5.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.9",
		"vite-tsconfig-paths": "^6.1.1"
	}
}
